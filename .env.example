# Copy to .env and fill in. Never commit .env.

# Report whose Opportunities will be updated (full URL or bare 00O… Id)
SALESFORCE_REPORT_URL=https://yourcompany.lightning.force.com/lightning/r/Report/00OXXXXXXXXXXXXXXX/view
# SALESFORCE_REPORT_ID=00OXXXXXXXXXXXXXXX

# Field label exactly as shown in Salesforce, and the value to write
TARGET_FIELD_LABEL=Solutions Engineer
TARGET_VALUE=Jane Doe

# Optional: your org's login URL (used in hints and by launch_chrome.sh)
# SALESFORCE_LOGIN_URL=https://yourcompany.my.salesforce.com/

# Default sheet mode (./run.sh): rows whose SHEET_TARGET_FIELD cell is empty
# get SHEET_TARGET_VALUE written to that field in Salesforce.
# SHEET_TARGET_FIELD=Solutions Engineer
# SHEET_TARGET_VALUE=Jane Doe

# Google Sheet export / sync (./run.sh sheet, ./run.sh sync)
# CD_SALESFORCE_STATUS_URL=https://docs.google.com/spreadsheets/d/XXXXXXXX/edit
# Columns exported to the sheet: Opportunity field labels, comma-separated.
# Use "Header=Field" when the sheet header differs from the field label.
# SHEET_COLUMNS=Opportunity Name=Name,Stage,Close Date,Next Step,Solutions Engineer
# Columns whose edits `./run.sh sync` pushes back to Salesforce (required for sync).
# SHEET_SYNC_COLUMNS=Stage,Next Step,Solutions Engineer
